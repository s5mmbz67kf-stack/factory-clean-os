# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only Supabase value (prefer the new secret key; legacy fallback supported)
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_ONLY_IF_USING_THE_LEGACY_FALLBACK

# Server-to-server website analytics ingestion
GROWTH_INGEST_SECRET=generate_a_long_random_secret

# Vercel Cron authorization for /api/cron/growth-agent
CRON_SECRET=generate_a_different_long_random_secret
